# Copy to .env ON THE SERVER. Never commit the populated file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPEN_KIOSK_HOST=127.0.0.1
PORT=4188
OPEN_KIOSK_DATA_DIR=.data
OPEN_KIOSK_DAILY_AI_LIMIT=200
# Use 1 only behind an HTTPS reverse proxy that you operate.
OPEN_KIOSK_SECURE_COOKIES=0
