[Unit]
Description=Open Kiosk university project demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/open-kiosk
ExecStart=/usr/local/bin/node %h/open-kiosk/src/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077
LimitNOFILE=4096
TimeoutStopSec=15

[Install]
WantedBy=default.target
